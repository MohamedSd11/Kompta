                  <xs:sequence>
                    <xs:element name="ord" type="xs:positiveInteger"/>
                    <xs:element name="matriculeCNSS" type="xs:string" minOccurs="0"/>
                    <xs:element name="nom" type="xs:string"/>
                    <xs:element name="prenom" type="xs:string"/>
                    <xs:element name="cin" type="xs:string" minOccurs="0"/>
                    <xs:element name="categorie" type="xs:string"/>
                    <xs:element name="dateEntree" type="xs:date" minOccurs="0"/>
                    <xs:element name="dateSortie" type="xs:date" minOccurs="0"/>
                    <xs:element name="brutImposable" type="xs:decimal"/>
                    <xs:element name="irRetenu" type="xs:decimal"/>
                    <xs:element name="netPaye" type="xs:decimal"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required"/>
    </xs:complexType>
